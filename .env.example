# Pick ONE provider and set LLM_PROVIDER accordingly.
LLM_PROVIDER=anthropic          # "anthropic", "openai", or "gemini"

ANTHROPIC_API_KEY=your-key-here
ANTHROPIC_MODEL=claude-sonnet-4-6

OPENAI_API_KEY=your-key-here
OPENAI_MODEL=gpt-4o-mini

GOOGLE_API_KEY=your-key-here
GEMINI_MODEL=gemini-2.5-flash

# Embeddings run locally by default (no key needed).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Paths
DATA_DIR=data/sample
INDEX_DIR=data/index

# Comma-separated browser origins allowed by CORS; replace with trusted frontend origins in production.
ALLOWED_ORIGINS=*

# Retrieval tuning
TOP_K_RETRIEVE=20     # candidates pulled before rerank
TOP_K_FINAL=4         # chunks sent to the LLM after rerank
HYBRID_ALPHA=0.5       # 0 = pure keyword, 1 = pure vector
